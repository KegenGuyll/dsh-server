# dsh-server runtime environment — copy to the server as
#   personal-pipeline/services/dsh-server/.env
# (the deploy agent writes this file from the SERVICE_ENV secret, plus TAG).
# Never commit a real .env; only this example is tracked.

# ── Required ──────────────────────────────────────────────────────────────

# The exact MagicDNS hostname browsers use to reach the server, as a BARE
# host[:port] authority — NO scheme, NO path (https://… is rejected: the
# /api trust fence compares Host headers, which carry no scheme). Format:
#   <hostname>.<tailnet>.ts.net      e.g. dsh-server.tail18ab49.ts.net
# (over standard HTTPS on 443, omit the port; a non-standard port must be
# included, e.g. dsh-server.tail18ab49.ts.net:8443). Find yours with:
#   tailscale status | grep dsh
DSH_TRUSTED_HOST=dsh.<tailnet>.ts.net

# DeepSeek API key (sk-…). Alternatively leave unset and configure the
# key in the web UI Models page — it persists in /data/.credentials.yaml.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ──────────────────────────────────────────────────────────────

# MagicDNS hostname for the sidecar node (default: dsh). If you change
# this, DSH_TRUSTED_HOST above must follow it.
#TS_HOSTNAME=dsh

# Image tag (sha-<commit>). Written by the deploy agent — no need to set
# it when deploying manually, only when pinning a rollback.
#TAG=sha-<commit>

# ── Baked into the image (overridable, defaults shown) ───────────────────
# DSH_HOME=/data                — sessions, settings, credentials
# DSH_TELEMETRY_DISABLED=1      — telemetry off by default
