{
  "name": "dsh-cost",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: a live per-session cost chip in the header utilities strip, priced at the session's current model, honoring DeepSeek's peak/off-peak rates and glowing red while inside a peak window. Prices are an estimate from published tier rates (the API reports tokens, not dollars).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/cost.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "install.mjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
